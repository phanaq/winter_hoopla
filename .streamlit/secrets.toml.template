# Copy this file to .streamlit/secrets.toml (local) or paste into
# Streamlit Cloud → App settings → Secrets. DO NOT commit secrets.toml!

[supabase]
url = "https://kywdoikmrtpzhbxicnxv.supabase.co"
# Use the SECRET key (sb_secret_... or the legacy service_role key).
# The app runs server-side, and the signups table is locked down with RLS,
# so the public/anon key cannot read it.
key = "sb_secret_..."

[email]
smtp_server = "smtp.gmail.com"
smtp_port = 587
sender_email = "your-email@gmail.com"
# Gmail App Password: https://myaccount.google.com/apppasswords
sender_password = "your-app-password-here"
enabled = true
